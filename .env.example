# ---------------------------------------------------------------------------
# Storefront API
# ---------------------------------------------------------------------------

# The Shopify store domain. `mock.shop` is a tokenless fictional apparel
# catalog — swap it for `your-store.myshopify.com` when you connect a real
# store. See https://mock.shop/llms.txt for other mock catalogs (pets.mock.shop,
# etc.).
NEXT_PUBLIC_STORE_DOMAIN=mock.shop

# Public Storefront API token. Leave this commented out for mock.shop:
# the Storefront client treats an absent token as tokenless access, which is all
# mock.shop supports. An *empty* assignment is parsed as an empty string and
# rejected by the client, so keep the `#`.
#
# Fill this in once you target a real store — a token is required for product
# tags, metafields, metaobjects, menus, and customers.
# NEXT_PUBLIC_STOREFRONT_API_TOKEN=

# Private Storefront API token. Server-only; never expose it to the browser.
# Needed to upgrade the SSR client to `type: "private"` with trusted buyer
# context.
# PRIVATE_STOREFRONT_API_TOKEN=

# Storefront ID for analytics. Use "0" when the app has no storefront ID.
NEXT_PUBLIC_STOREFRONT_ID=0

# Checkout domain, for app-level concerns such as CSP. Checkout links come from
# cart data (`cart.checkoutUrl`), not from this value.
# NEXT_PUBLIC_CHECKOUT_DOMAIN=

# ---------------------------------------------------------------------------
# Shopify runtime scripts + Customer Account API
# ---------------------------------------------------------------------------

# Numeric Shopify shop ID as a string of digits (not a GID, not a domain).
# Required by ShopifyScripts and the Customer Account API. mock.shop has no
# shop ID, so leave it unset while developing against a mock catalog.
# SHOP_ID=

# Customer Account API OAuth client ID. Unset for mock.shop — the account
# routes are not registered and /account shows a "not configured" panel.
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=

# Secret used to encrypt the customer session cookie. Generate with:
#   openssl rand -base64 32
# Prefer opaque server-side sessions in production.
# CUSTOMER_ACCOUNT_SESSION_SECRET=
